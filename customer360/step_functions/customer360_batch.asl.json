{
  "Comment": "Customer 360 End-to-End Batch Lakehouse Orchestration State Machine",
  "StartAt": "InitializePipeline",
  "States": {
    "InitializePipeline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${initialize_lambda_arn}",
        "Payload": {
          "environment.$": "$$.Execution.Input.environment",
          "dry_run.$": "$$.Execution.Input.dry_run",
          "sources.$": "$$.Execution.Input.sources"
        }
      },
      "ResultSelector": {
        "run_id.$": "$.Payload.run_id",
        "environment.$": "$.Payload.environment",
        "dry_run.$": "$.Payload.dry_run",
        "sources.$": "$.Payload.sources",
        "execution_start.$": "$.Payload.execution_start"
      },
      "ResultPath": "$.init",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "ProcessAllSourcesParallel"
    },

    "ProcessAllSourcesParallel": {
