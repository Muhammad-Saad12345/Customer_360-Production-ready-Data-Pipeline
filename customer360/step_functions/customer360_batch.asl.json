{
  "Comment": "Customer 360 daily batch. Failures are NOT caught at the top level: a failed execution emits an EventBridge status-change event (alerting) and can be redriven from the failed state.",
  "StartAt": "InitializePipeline",
  "TimeoutSeconds": 10800,
  "States": {
    "InitializePipeline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${initialize_lambda_arn}",
        "Payload": {
          "input.$": "$$.Execution.Input",
          "execution_name.$": "$$.Execution.Name",
          "execution_arn.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id"
        }
      },
      "ResultSelector": {
        "run_id.$": "$.Payload.run_id",
        "environment.$": "$.Payload.environment",
        "dry_run.$": "$.Payload.dry_run",
        "sources.$": "$.Payload.sources",
        "mandatory_sources.$": "$.Payload.mandatory_sources"
      },
      "ResultPath": "$.init",
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Lambda.Unknown",
            "Sandbox.Timedout",
            "TransientError"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "ProcessSources"
    },
    "ProcessSources": {
      "Type": "Map",
      "ItemsPath": "$.init.sources",
      "ItemSelector": {
        "source.$": "$$.Map.Item.Value.source",
        "entity.$": "$$.Map.Item.Value.entity",
        "run_id.$": "$.init.run_id",
        "environment.$": "$.init.environment",
        "dry_run.$": "$.init.dry_run"
      },
      "MaxConcurrency": 6,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Ingest",
        "States": {
          "Ingest": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${ingest_lambda_arn}",
              "Payload": {
                "source.$": "$.source",
                "entity.$": "$.entity",
                "run_id.$": "$.run_id",
                "environment.$": "$.environment",
                "dry_run.$": "$.dry_run"
              }
            },
            "ResultSelector": {
              "status.$": "$.Payload.status",
              "records_ingested.$": "$.Payload.records_ingested",
              "s3_raw_key.$": "$.Payload.s3_raw_key",
              "source_mode.$": "$.Payload.source_mode"
            },
            "ResultPath": "$.ingest",
            "TimeoutSeconds": 960,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "Lambda.Unknown",
                  "Sandbox.Timedout",
                  "TransientError"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "SourceFailed"
              }
            ],
            "Next": "SilverGate"
          },
          "SilverGate": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${silver_gate_lambda_arn}",
              "Payload": {
                "source.$": "$.source",
                "entity.$": "$.entity",
                "run_id.$": "$.run_id",
                "environment.$": "$.environment",
                "dry_run.$": "$.dry_run",
                "s3_raw_key.$": "$.ingest.s3_raw_key"
              }
            },
            "ResultSelector": {
              "valid_count.$": "$.Payload.valid_count",
              "invalid_count.$": "$.Payload.invalid_count",
              "silver_path.$": "$.Payload.silver_path",
              "quarantine_path.$": "$.Payload.quarantine_path"
            },
            "ResultPath": "$.silver",
            "TimeoutSeconds": 960,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "Lambda.Unknown",
                  "Sandbox.Timedout",
                  "TransientError"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "SourceFailed"
              }
            ],
            "Next": "QualityCheck"
          },
          "QualityCheck": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${quality_check_lambda_arn}",
              "Payload": {
                "source.$": "$.source",
                "entity.$": "$.entity",
                "run_id.$": "$.run_id",
                "environment.$": "$.environment",
                "dry_run.$": "$.dry_run",
                "valid_count.$": "$.silver.valid_count",
                "invalid_count.$": "$.silver.invalid_count",
                "silver_path.$": "$.silver.silver_path"
              }
            },
            "ResultSelector": {
              "verdict.$": "$.Payload.verdict",
              "rejection_rate_pct.$": "$.Payload.rejection_rate_pct"
            },
            "ResultPath": "$.quality",
            "TimeoutSeconds": 360,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "Lambda.Unknown",
                  "Sandbox.Timedout",
                  "TransientError"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "SourceFailed"
              }
            ],
            "Next": "IcebergLoad"
          },
          "IcebergLoad": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${iceberg_load_lambda_arn}",
              "Payload": {
                "source.$": "$.source",
                "entity.$": "$.entity",
                "run_id.$": "$.run_id",
                "environment.$": "$.environment",
                "dry_run.$": "$.dry_run",
                "silver_path.$": "$.silver.silver_path",
                "valid_count.$": "$.silver.valid_count"
              }
            },
            "ResultSelector": {
              "status.$": "$.Payload.status",
              "loaded_row_count.$": "$.Payload.loaded_row_count",
              "athena_executed.$": "$.Payload.athena_executed"
            },
            "ResultPath": "$.load",
            "TimeoutSeconds": 960,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "Lambda.Unknown",
                  "Sandbox.Timedout",
                  "TransientError"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "SourceFailed"
              }
            ],
            "Next": "SourceSucceeded"
          },
          "SourceSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "source.$": "$.source",
              "entity.$": "$.entity",
              "status": "succeeded",
              "source_mode.$": "$.ingest.source_mode",
              "records_ingested.$": "$.ingest.records_ingested",
              "valid_count.$": "$.silver.valid_count",
              "invalid_count.$": "$.silver.invalid_count",
              "rejection_rate_pct.$": "$.quality.rejection_rate_pct",
              "load_status.$": "$.load.status",
              "loaded_row_count.$": "$.load.loaded_row_count",
              "athena_executed.$": "$.load.athena_executed"
            },
            "End": true
          },
          "SourceFailed": {
            "Type": "Pass",
            "Comment": "Isolates one source's failure; ReconcileRun decides whether the run may continue.",
            "Parameters": {
              "source.$": "$.source",
              "entity.$": "$.entity",
              "status": "failed",
              "error.$": "$.error.Error",
              "cause.$": "$.error.Cause"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.branch_results",
      "Next": "ReconcileRun"
    },
    "ReconcileRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${reconcile_lambda_arn}",
        "Payload": {
          "run_id.$": "$.init.run_id",
          "environment.$": "$.init.environment",
          "dry_run.$": "$.init.dry_run",
          "mandatory_sources.$": "$.init.mandatory_sources",
          "branch_results.$": "$.branch_results"
        }
      },
      "ResultSelector": {
        "reconciliation_status.$": "$.Payload.reconciliation_status",
        "failed_sources.$": "$.Payload.failed_sources",
        "warnings.$": "$.Payload.warnings"
      },
      "ResultPath": "$.reconcile",
      "TimeoutSeconds": 360,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Lambda.Unknown",
            "Sandbox.Timedout",
            "TransientError"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "GateTransform"
    },
    "GateTransform": {
      "Type": "Choice",
      "Comment": "ReconcileRun raises ReconciliationFailed for blocking problems, so only pass/warn reach here.",
      "Choices": [
        {
          "Variable": "$.init.dry_run",
          "BooleanEquals": true,
          "Next": "DryRunComplete"
        },
        {
          "Variable": "$.reconcile.reconciliation_status",
          "StringEquals": "PASSED_WITH_WARNINGS",
          "Next": "NotifyWarnings"
        },
        {
          "Variable": "$.reconcile.reconciliation_status",
          "StringEquals": "PASSED",
          "Next": "DbtRun"
        }
      ],
      "Default": "UnexpectedReconcileStatus"
    },
    "NotifyWarnings": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${notify_lambda_arn}",
        "Payload": {
          "run_id.$": "$.init.run_id",
          "environment.$": "$.init.environment",
          "severity": "WARNING",
          "failed_sources.$": "$.reconcile.failed_sources",
          "warnings.$": "$.reconcile.warnings",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": {
        "sns_message_id.$": "$.Payload.sns_message_id"
      },
      "ResultPath": "$.notify",
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Lambda.Unknown",
            "Sandbox.Timedout",
            "TransientError"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "DbtRun",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "DbtRun"
        }
      ]
    },
    "DbtRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${glue_dbt_job_name}",
        "Arguments": {
          "--dbt-action": "run",
          "--dbt-target.$": "$.init.environment",
          "--run-id.$": "$.init.run_id",
          "--s3-dbt-path": "${s3_dbt_path}"
        }
      },
      "ResultSelector": {
        "job_run_id.$": "$.Id",
        "state.$": "$.JobRunState"
      },
      "ResultPath": "$.dbt_run",
      "TimeoutSeconds": 3900,
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException",
            "Glue.ThrottlingException"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "DbtTest"
    },
    "DbtTest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${glue_dbt_job_name}",
        "Arguments": {
          "--dbt-action": "test",
          "--dbt-target.$": "$.init.environment",
          "--run-id.$": "$.init.run_id",
          "--s3-dbt-path": "${s3_dbt_path}"
        }
      },
      "ResultSelector": {
        "job_run_id.$": "$.Id",
        "state.$": "$.JobRunState"
      },
      "ResultPath": "$.dbt_test",
      "TimeoutSeconds": 3900,
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException",
            "Glue.ThrottlingException"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "PipelineSucceeded"
    },
    "DryRunComplete": {
      "Type": "Succeed",
      "Comment": "Dry run: nothing written beyond raw manifests; dbt skipped."
    },
    "UnexpectedReconcileStatus": {
      "Type": "Fail",
      "Error": "UnexpectedReconcileStatus",
      "Cause": "ReconcileRun returned a status this state machine does not handle."
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    }
  }
}