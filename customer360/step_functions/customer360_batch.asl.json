            },
            "QualityCheck_Support": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${quality_check_lambda_arn}",
                "Payload": {
                  "source": "support",
                  "entity": "tickets",
                  "run_id.$": "$.init.run_id",
                  "input_record_count.$": "$.silver.input_record_count",
                  "valid_count.$": "$.silver.valid_count",
                  "invalid_count.$": "$.silver.invalid_count",
                  "silver_path.$": "$.silver.silver_path",
                  "environment.$": "$.init.environment",
                  "dry_run.$": "$.init.dry_run"
                }
              },
              "ResultSelector": {
                "source.$": "$.Payload.source",
                "entity.$": "$.Payload.entity",
                "run_id.$": "$.Payload.run_id",
                "valid_count.$": "$.Payload.valid_count",
                "invalid_count.$": "$.Payload.invalid_count",
                "rejection_rate_pct.$": "$.Payload.rejection_rate_pct",
                "silver_path.$": "$.Payload.silver_path"
              },
              "ResultPath": "$.quality",
              "Next": "IcebergLoad_Support"
            },
            "IcebergLoad_Support": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${iceberg_load_lambda_arn}",
                "Payload": {
                  "source": "support",
                  "entity": "tickets",
                  "run_id.$": "$.init.run_id",
                  "valid_count.$": "$.quality.valid_count",
                  "silver_path.$": "$.quality.silver_path",
                  "environment.$": "$.init.environment",
                  "dry_run.$": "$.init.dry_run"
                }
              },
              "ResultSelector": {
                "source.$": "$.Payload.source",
                "entity.$": "$.Payload.entity",
                "run_id.$": "$.Payload.run_id",
                "silver_row_count.$": "$.Payload.silver_row_count",
                "deduped_row_count.$": "$.Payload.deduped_row_count",
                "status.$": "$.Payload.status"
              },
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "ReconcileRun"
    },

    "ReconcileRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${reconcile_lambda_arn}",
        "Payload": {
          "run_id.$": "$.init.run_id",
          "environment.$": "$.init.environment",
          "branch_results.$": "$.branch_results"
        }
      },
      "ResultSelector": {
        "run_id.$": "$.Payload.run_id",
        "reconciliation_status.$": "$.Payload.reconciliation_status",
        "total_sources_evaluated.$": "$.Payload.total_sources_evaluated",
        "total_silver_records.$": "$.Payload.total_silver_records",
        "total_loaded_records.$": "$.Payload.total_loaded_records",
        "discrepancies.$": "$.Payload.discrepancies",
        "status.$": "$.Payload.status"
      },
      "ResultPath": "$.reconcile",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "DbtRun"
    },

    "DbtRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${glue_dbt_job_name}",
        "Arguments": {
          "--dbt-action": "run",
          "--dbt-target.$": "$.init.environment",
          "--run-id.$": "$.init.run_id",
          "--s3-dbt-path": "${s3_dbt_path}"
        }
      },
      "ResultPath": "$.dbt_run",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "DbtTest"
    },

    "DbtTest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${glue_dbt_job_name}",
        "Arguments": {
          "--dbt-action": "test",
          "--dbt-target.$": "$.init.environment",
          "--run-id.$": "$.init.run_id",
          "--s3-dbt-path": "${s3_dbt_path}"
        }
      },
      "ResultPath": "$.dbt_test",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "IcebergMaintenance"
    },

    "IcebergMaintenance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${iceberg_maintenance_lambda_arn}",
        "Payload": {
          "run_id.$": "$.init.run_id",
          "environment.$": "$.init.environment",
          "dry_run.$": "$.init.dry_run"
        }
      },
      "ResultSelector": {
        "run_id.$": "$.Payload.run_id",
        "status.$": "$.Payload.status",
        "tables_processed.$": "$.Payload.tables_processed"
      },
      "ResultPath": "$.maintenance",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.maintenance_error",
          "Next": "PipelineSuccess"
        }
      ],
      "Next": "PipelineSuccess"
    },

    "PipelineSuccess": {
      "Type": "Succeed"
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${notify_lambda_arn}",
        "Payload": {
          "run_id.$": "$.init.run_id",
          "status": "failed",
          "error.$": "$.error",
          "execution_id.$": "$$.Execution.Id",
          "environment.$": "$.init.environment"
        }
      },
      "ResultPath": "$.notification",
      "Next": "PipelineFailed"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineExecutionFailed",
      "Cause": "Customer 360 batch pipeline failed in one or more stages. Details notified via SNS."
    }
  }
}
