# ==============================================================================
# Customer 360 Lakehouse — Environment Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS TO THIS FILE OR TO VERSION CONTROL
# ==============================================================================

# Target Environment: dev | staging | prod
ENVIRONMENT=dev

# AWS Core Configuration
AWS_REGION=us-east-1
S3_BUCKET=customer360-lakehouse-dev

# AWS Secrets Manager Configuration
# In production and staging, credentials are automatically resolved from this secret.
SECRETS_MANAGER_SECRET_NAME=c_360_secret_manager

# HubSpot API (In dev, mock/sandbox token; in prod/staging, fetched from Secrets Manager)
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_LOOKBACK_MINUTES=15

# Marketing / Email Provider (mailchimp | synthetic)
MARKETING_PROVIDER=synthetic
MARKETING_API_KEY=your_marketing_api_key_here
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# Zendesk Support API
ZENDESK_SUBDOMAIN=your_zendesk_subdomain
ZENDESK_API_KEY=your_zendesk_api_key_here
ZENDESK_EMAIL=service-account@example.com

# Mock Source Service Endpoints (Local Container / Dev Mode)
OMS_BASE_URL=http://localhost:8001
PIM_BASE_URL=http://localhost:8002
LOYALTY_BASE_URL=http://localhost:8003
LOYALTY_API_KEY=your_loyalty_api_key_here

# Apache Iceberg & AWS Athena Lakehouse Settings
ICEBERG_DATABASE=customer360_iceberg_dev
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://customer360-lakehouse-dev/athena-results/
ICEBERG_S3_PREFIX=iceberg
ICEBERG_MAINTENANCE_RETENTION_DAYS=7

# Data Quality Thresholds
REJECTION_RATE_THRESHOLD=0.10

# Logging & Observability
LOG_LEVEL=INFO
SNS_ALERT_TOPIC_ARN=
